# 镜像版本固定在明确版本；升级时只修改这里的版本号。
XBAR_CORE_IMAGE=langrentaole/xbar-core:0.023
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7.4-alpine
CADDY_IMAGE=caddy:2.10-alpine

# 对外域名。PUBLIC_URL 必须与 CORE_DOMAIN 完全对应。
CORE_DOMAIN=xbar.example.com
PUBLIC_URL=https://xbar.example.com
ACME_EMAIL=admin@example.com

# 用户端来源。用户端部署在同一台服务器并监听 18080 时无需修改。
# 也可填写仅供 Core 访问的独立来源，例如 https://user-origin.example.com。
USER_UPSTREAM=http://host.docker.internal:18080

# 独立 Vibe 数据面地址；必须使用 HTTPS。
VIBE_GATEWAY_URL=https://vibe.example.com

# 首次执行 ./deploy.sh init 时会自动生成以下值。
MYSQL_PASSWORD=replace-with-random-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-random-mysql-root-password
COOKIE_KEY=replace-with-random-cookie-key
DATA_KEY=replace-with-exactly-32-byte-data-key
VERIFICATION_KEY=replace-with-random-verification-key
EDGE_INTERNAL_KEY=replace-with-random-edge-internal-key
VIBE_EDGE_SHARED_SECRET=replace-with-shared-vibe-secret

# 首次执行 ./deploy.sh init 时会生成随机初始密码；登录后可在管理端修改。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-random-admin-password

# 运行参数。
TIMEZONE=Asia/Shanghai
USER_SESSION_TTL=24h
ADMIN_SESSION_TTL=12h
ADMIN_IDLE_TIMEOUT=30m
CHAT_SESSION_TTL=24h
SHUTDOWN_TIMEOUT=30m
USAGE_RESERVATION_STALE_AFTER=24h
MYSQL_BINLOG_RETENTION_SECONDS=604800

